{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UCS Client Schema (OpenSRP)",
  "description": "JSON schema for validating OpenSRP Client data structure",
  "type": "object",
  "required": ["baseEntityId", "firstName", "lastName", "gender", "identifiers"],
  "properties": {
    "baseEntityId": {
      "type": "string",
      "minLength": 1,
      "description": "Base entity identifier (required)"
    },
    "type": {
      "type": ["string", "null"],
      "description": "Entity type (e.g. Client)"
    },
    "identifiers": {
      "type": "object",
      "description": "Map of identifier type to value (e.g. opensrp_id, zeir_id)"
    },
    "firstName": {
      "type": "string",
      "minLength": 1,
      "description": "Client's first name"
    },
    "middleName": {
      "type": ["string", "null"],
      "description": "Client's middle name (optional)"
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "description": "Client's last name"
    },
    "birthdate": {
      "type": ["string", "null"],
      "description": "Birth date as ISO datetime string (e.g. 1990-01-15T00:00:00.000+0300)"
    },
    "birthdateApprox": {
      "type": ["boolean", "null"],
      "description": "Whether birth date is approximate"
    },
    "gender": {
      "type": "string",
      "minLength": 1,
      "description": "Gender (Male, Female, or single-letter M/F/O)"
    },
    "addresses": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "addressType": { "type": ["string", "null"] },
          "country": { "type": ["string", "null"] },
          "stateProvince": { "type": ["string", "null"] },
          "cityVillage": { "type": ["string", "null"] },
          "countyDistrict": { "type": ["string", "null"] },
          "subDistrict": { "type": ["string", "null"] },
          "town": { "type": ["string", "null"] },
          "subTown": { "type": ["string", "null"] },
          "addressFields": { "type": ["object", "null"] }
        }
      },
      "description": "Client addresses"
    },
    "attributes": {
      "type": ["object", "null"],
      "description": "Map of attribute type to value (e.g. national_id, phone_number)"
    },
    "relationships": {
      "type": ["object", "null"],
      "description": "Map of relationship type to list of related entity IDs"
    },
    "clientType": {
      "type": ["string", "null"],
      "description": "Client type (e.g. ec_family, ec_family_member)"
    },
    "teamId": {
      "type": ["string", "null"],
      "description": "Team identifier"
    },
    "locationId": {
      "type": ["string", "null"],
      "description": "Location identifier"
    },
    "serverVersion": {
      "type": ["number", "null"],
      "description": "Server version for incremental sync"
    },
    "dateCreated": {
      "type": ["string", "null"],
      "description": "Creation timestamp"
    },
    "dateEdited": {
      "type": ["string", "null"],
      "description": "Last edit timestamp"
    },
    "voided": {
      "type": ["boolean", "null"],
      "description": "Whether the client record has been voided"
    }
  }
}
