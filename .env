OPENHIM_PASSWORD=SmartBridge@2026
OPENHIM_TRUST_SELF_SIGNED=true

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=smartbridge
RABBITMQ_PASSWORD=smartbridge123
RABBITMQ_VHOST=/

# Security Configuration
SSL_ENABLED=false
TLS_ENABLED=false
ENCRYPTION_KEY=VhSR0PnpWzbCzvdTHa9O8yVkNvJtqXo326tPE/qdtJE=

# Monitoring
METRICS_ENABLED=true
