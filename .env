# Smart Bridge Environment Configuration

# UCS Configuration (OpenSRP)
UCS_API_URL=https://ucs-opensrp-dev.d-tree.org/opensrp
UCS_TIMEOUT=30000
# Options: basic, token, or keycloak
UCS_AUTH_TYPE=basic
UCS_USERNAME=admin
UCS_PASSWORD=UcsOpenmrsPassword2023

# Keycloak auth (only needed if UCS_AUTH_TYPE=keycloak)
# UCS_KEYCLOAK_TOKEN_URL=https://keycloak.example.com/realms/opensrp/protocol/openid-connect/token
# UCS_KEYCLOAK_CLIENT_ID=opensrp-client
# UCS_KEYCLOAK_CLIENT_SECRET=

# Sync settings
